# ============================================================
# Big Data Movie Recommender - .gitignore
# ============================================================

# Dataset files (user must download separately)
data/*.csv
data/processed/

# Model artifacts (generated by training)
models/*.pkl
models/*.joblib

# Output files (generated by scripts)
output/
!output/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
*.egg

# Java compiled files
mapreduce/*.class
mapreduce/*.jar

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment and credentials
.env
config/config.env

# Streamlit
.streamlit/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
