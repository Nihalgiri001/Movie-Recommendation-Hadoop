# ============================================================
# Big Data Movie Recommender - Configuration Template
# ============================================================
# Copy this file to config.env and fill in your values.
# NEVER commit config.env to GitHub.
# ============================================================

# ---- MySQL Configuration (for Sqoop) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=movie_recommender
MYSQL_USER=root
MYSQL_PASSWORD=cloudera

# ---- HDFS Configuration ----
# Leave blank to auto-detect via $(whoami)
HDFS_USER=
HDFS_BASE_PATH=/user/${HDFS_USER:-$(whoami)}/movie_recommender

# ---- Dataset Paths (relative to project root) ----
DATA_DIR=data
MOVIES_CSV=data/tmdb_5000_movies.csv
CREDITS_CSV=data/tmdb_5000_credits.csv

# ---- Output Paths (relative to project root) ----
OUTPUT_DIR=output
MODELS_DIR=models

# ---- Python Configuration ----
PYTHON_CMD=python3
PIP_CMD=pip3

# ---- Recommendation Settings ----
NUM_RECOMMENDATIONS=10
KNN_NEIGHBORS=5
KMEANS_CLUSTERS=3
